{
    "name": "Angular, .NET, PostgreSQL",
    "dockerComposeFile": "compose.yaml",
    "service": "workspace",
    "workspaceFolder": "/workspace/gradebook",
    "forwardPorts": [
        4200,
        5432,
        8080
    ],
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": true,
            "installOhMyZsh": true,
            "configureZshAsDefaultShell": true
        },
        "ghcr.io/devcontainers/features/github-cli": {
            "version": "latest"
        }
    },
    "containerEnv": {
        "ASPNETCORE_URLS": "http://0.0.0.0:8080"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-dotnettools.csdevkit",
                "ms-dotnettools.vscode-dotnet-runtime",
                "angular.ng-template",
                "dbaeumer.vscode-eslint",
                "esbenp.prettier-vscode",
                "ckolkman.vscode-postgres",
                "ms-azuretools.vscode-docker"
            ]
        }
    },
    "initializeCommand": "sh -c 'test -f \"${localWorkspaceFolder}/.devcontainer/.env\" || cp \"${localWorkspaceFolder}/.devcontainer/.env.example\" \"${localWorkspaceFolder}/.devcontainer/.env\"'",
    "postCreateCommand": {
        "dotnet-restore": "cd ${containerWorkspaceFolder}/backend && dotnet restore",
        "frontend-install": "cd ${containerWorkspaceFolder}/frontend && npm install"
    }
}
